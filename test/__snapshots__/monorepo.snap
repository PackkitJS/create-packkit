===== README.md =====
# fixture

A fixture project.

## Packages

- `@fixture/core` — the core library
- `@fixture/utils` — utilities built on `@fixture/core`

## Develop

```sh
pnpm install
pnpm build     # build all packages (Turborepo)
pnpm test
```

## License

MIT © Fixture Author <fixture@example.com>

===== SECURITY.md =====
# Security Policy

If you discover a security vulnerability, please **do not** open a public issue.
Instead, report it privately to the maintainers (e.g. via GitHub Security
Advisories). We will respond as quickly as possible.

===== eslint.config.js =====
import js from '@eslint/js';
import tseslint from 'typescript-eslint';

export default tseslint.config(
	js.configs.recommended,
	...tseslint.configs.recommended,
	{ ignores: ['**/dist'] },
);

===== package.json =====
{
  "name": "fixture",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.10.0",
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "dev": "turbo dev",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo build && changeset publish"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.9.3",
    "tsup": "^8.0.0",
    "vitest": "^4.0.0",
    "eslint": "^10.0.0",
    "@eslint/js": "^10.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.3.0",
    "@changesets/cli": "^2.27.0",
    "@types/node": "^24.0.0"
  }
}

===== packages/core/package.json =====
{
  "name": "@fixture/core",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  }
}

===== packages/core/src/index.test.ts =====
import { describe, it, expect } from 'vitest';
import { greet } from './index.js';

describe('example', () => {
	it('works', () => {
		expect(greet('world')).toBe('Hello, world!');
	});
});

===== packages/core/src/index.ts =====
/** Greet someone by name. */
export function greet(name: string): string {
	return `Hello, ${name}!`;
}

===== packages/core/tsconfig.json =====
{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src"
  ]
}

