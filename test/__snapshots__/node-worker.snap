===== src/handler.ts =====
/**
 * Business logic for one message — the unit-testable seam. Pure: no queue, no
 * logging. Throw to signal a failure the worker should retry (and, after
 * WORKER_MAX_ATTEMPTS, route to the poison-message handler).
 */
export async function handle(message: string): Promise<void> {
	if (!message.trim()) throw new Error('empty message');
	// TODO: replace with your processing.
}

===== src/index.ts =====
import { run } from './worker.js';

run()
	.then((code) => process.exit(code))
	.catch((error) => {
		console.error(error);
		process.exit(1);
	});

===== src/worker.test.ts =====
import { spawn } from 'node:child_process';
import { describe, it, expect } from 'vitest';
import { handle } from './handler.js';

describe('handler', () => {
	it('accepts a message', async () => {
		await expect(handle('hello')).resolves.toBeUndefined();
	});
	it('rejects an empty message', async () => {
		await expect(handle('   ')).rejects.toThrow();
	});
});

describe('worker', () => {
	it('drains on SIGTERM and exits 0', async () => {
		const child = spawn(...[process.execPath, ['--import', 'tsx', 'src/index.ts']], { stdio: ['pipe', 'pipe', 'inherit'] });
		let out = '';
		child.stdout.on('data', (d) => (out += String(d)));
		child.stdin.write('one\n');
		await new Promise((r) => setTimeout(r, 600)); // let the in-flight message be handled
		child.kill('SIGTERM');
		const code = await new Promise((resolve) => child.on('exit', resolve));
		expect(code).toBe(0);
		expect(out).toContain('"event":"handled"');
		expect(out).toContain('"event":"worker_stopped"');
	}, 15000);
});

===== src/worker.ts =====
/**
 * A transport-agnostic background worker: pull messages from a source, run the
 * handler with bounded retries, and drain in-flight work on SIGTERM/SIGINT before
 * exiting 0. No queue SDK is baked in — wire receive() to your transport. Logs are
 * JSON lines on stdout; liveness is the process, so there is no HTTP port.
 */
import { createInterface } from 'node:readline';
import { handle } from './handler.js';

interface Config {
	maxAttempts: number;
	logLevel: string;
}

export function loadConfig(): Config {
	return {
		maxAttempts: Number(process.env.WORKER_MAX_ATTEMPTS ?? 3),
		logLevel: process.env.WORKER_LOG_LEVEL ?? 'info',
	};
}

export function log(event: string, fields: Record<string, unknown> = {}): void {
	process.stdout.write(JSON.stringify({ level: 'info', event, ...fields }) + '\n');
}

/** A message that failed every attempt. Default: log and drop. Replace with a
 *  dead-letter queue, a table, an alert — whatever poison means for your system. */
export async function onPoison(message: string, error: unknown): Promise<void> {
	log('poison_message', { level: 'error', message, error: String(error) });
}

async function processMessage(message: string, config: Config): Promise<void> {
	for (let attempt = 1; attempt <= config.maxAttempts; attempt++) {
		try {
			await handle(message);
			log('handled', { message, attempt });
			return;
		} catch (error) {
			log('handle_failed', { level: 'warning', message, attempt, error: String(error) });
			if (attempt === config.maxAttempts) await onPoison(message, error);
		}
	}
}

export async function run(): Promise<number> {
	const config = loadConfig();
	const rl = createInterface({ input: process.stdin });
	let shuttingDown = false;
	const requestShutdown = (signal: string) => {
		if (shuttingDown) return;
		shuttingDown = true;
		log('shutdown_requested', { signal });
		rl.close(); // end the async iterator so a drain is not stuck waiting for input
	};
	process.on('SIGTERM', () => requestShutdown('SIGTERM'));
	process.on('SIGINT', () => requestShutdown('SIGINT'));
	log('worker_started', { maxAttempts: config.maxAttempts });

	let processed = 0;
	for await (const line of rl) {
		await processMessage(line, config); // finish this message before re-checking shutdown
		processed++;
		if (shuttingDown) break;
	}
	log('worker_stopped', { processed, drained: shuttingDown });
	return 0;
}

