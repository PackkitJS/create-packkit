import vue from '@vitejs/plugin-vue';

import { defineConfig } from 'vite';

export default defineConfig({
	plugins: [vue()],
});

===== vitest.config.ts =====
import vue from '@vitejs/plugin-vue';
import { defineConfig } from 'vitest/config';

export default defineConfig({
	plugins: [vue()],
	test: {
		environment: 'jsdom',
		globals: true,
		coverage: { provider: 'v8', reporter: ['text', 'lcov'] },
	},
});
