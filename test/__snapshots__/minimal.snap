MIT © Fixture Author <fixture@example.com>

===== package.json =====
{
  "name": "fixture",
  "version": "0.0.0",
  "description": "A fixture project.",
  "homepage": "https://github.com/fixture/fixture#readme",
  "bugs": {
    "url": "https://github.com/fixture/fixture/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fixture/fixture.git"
  },
  "license": "MIT",
  "author": "Fixture Author <fixture@example.com>",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "tsup",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "rimraf": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3"
  }
}

